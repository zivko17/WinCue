bin/
obj/
*.user
.vs/
TestResults/
publish/
artifacts/
graphify-out/

# Media de prueba HAP (generada por tests/hap-test/generar-media.ps1)
tests/hap-test/*.mov
tests/hap-test/*.mp4

# Media de prueba ProRes (generada por tests/prores-test/generar-media.ps1)
tests/prores-test/*.mov
tests/prores-test/*.mp4

# DLL nativas LGPL de FFmpeg (motor ProRes propio): NO se versionan, se
# obtienen con tools/ffmpeg-lgpl/obtener-ffmpeg-lgpl.ps1. Lo que SÍ se versiona
# es la PROCEDENCIA (ffmpeg-BUILD.txt), que la LGPL obliga a poder ofrecer.
ffmpeg-lgpl/bin/
ffmpeg-lgpl/LICENSE.txt
ffmpeg-lgpl/_extract/

# libmpv LGPL (la que se distribuye, 98 MB): mismo criterio — el binario no se
# versiona, se obtiene con tools/libmpv-lgpl/obtener-libmpv-lgpl.ps1; lo que SÍ
# se versiona es libmpv-BUILD.txt con la procedencia y el SHA256.
libmpv-lgpl/*.dll
libmpv-lgpl/*.7z
libmpv-lgpl/_extract/

# Salidas de `dotnet publish` del banco de pruebas WinUI 3 de Secuence
# (hito 0): cientos de archivos, ~160 MB, desechables y regenerables con los
# comandos de tools/winui3-lab/INFORME.md. Sin esto, un `git add` normal del
# lab se lleva por delante toda esta carpeta.
tools/winui3-lab/pub-carpeta/
tools/winui3-lab/pub-single/
