<Project Sdk="Microsoft.NET.Sdk">

  <!-- ==========================================================================
       WinCue.Presentation — lo que la interfaz necesita y NO es de ningún
       framework de interfaz: medidas, valores de color, glifos de icono.
       net8.0 a secas, como el motor: lo consumen WinCue.App (WPF) y, cuando
       exista, Secuence.App (WinUI 3). Si algo de aquí necesita un tipo de WPF
       o de WinUI, es que no es de aquí.
       ========================================================================== -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ==========================================================================
       TimelineLayout.cs (hitos-0-1, timeline) necesita recorrer un CueModel
       real: Cue/CueModel/GroupMode/ActiveCueInfo/IShowClock son el MOTOR
       (net8.0 a secas, sin una sola línea de WPF ni de WinUI — comprobado en
       sus .csproj), no "framework de interfaz". La regla de la cabecera de
       este fichero sigue intacta: si algo de aquí necesitara Color, Brush o
       cualquier tipo de WPF/WinUI, ESE sería el sitio equivocado.
       ========================================================================== -->
  <ItemGroup>
    <ProjectReference Include="..\WinCue.Core\WinCue.Core.csproj" />
    <ProjectReference Include="..\WinCue.Controller\WinCue.Controller.csproj" />
  </ItemGroup>

</Project>
