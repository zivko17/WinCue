<Window x:Class="WinCue.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinCue.App"
        Title="WinCue" Width="1280" Height="800"
        Background="#1e1e1e" WindowState="Maximized"
        AllowDrop="True">

    <Window.Resources>
        <!-- Paleta oscura básica -->
        <SolidColorBrush x:Key="Bg" Color="#1e1e1e"/>
        <SolidColorBrush x:Key="Panel" Color="#252526"/>
        <SolidColorBrush x:Key="Fg" Color="#dddddd"/>
        <SolidColorBrush x:Key="FgDim" Color="#888888"/>
        <SolidColorBrush x:Key="Accent" Color="#2ecc71"/>
        <SolidColorBrush x:Key="PlayheadBg" Color="#264f78"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ═══════════ TOP BAR: transport + master ═══════════ -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Panel}" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="GoButton" Click="OnGoClick" Width="110" Height="44"
                            Background="#1e7e34" FontSize="20" FontWeight="Bold"
                            Content="GO ▶" ToolTip="Espacio"/>
                    <Button x:Name="StopAllButton" Click="OnStopAllClick" Height="44"
                            Content="■ STOP ALL" ToolTip="Escape"/>
                    <Button x:Name="FadeAllButton" Click="OnFadeAllClick" Height="44"
                            Content="◢ FADE ALL" ToolTip="Fundido elegante de todo (Settings → duración)"/>
                    <Button x:Name="PanicButton" Click="OnPanicClick" Height="44"
                            Background="#7e1e1e" Content="⚠ PANIC"/>
                    <Button x:Name="PauseButton" Click="OnPauseClick" Height="44"
                            Content="⏸ PAUSA"/>
                    <StackPanel VerticalAlignment="Center" Margin="10,0,0,0" MaxWidth="240">
                        <TextBlock Text="SIGUIENTE" FontSize="9"
                                   Foreground="{StaticResource FgDim}"/>
                        <TextBlock x:Name="NextCueLabel" Text="—" FontSize="14"
                                   FontWeight="Bold" TextTrimming="CharacterEllipsis"
                                   Foreground="#e8c000"/>
                    </StackPanel>
                </StackPanel>

                <!-- Botones al extremo derecho, con código de color -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right"
                            VerticalAlignment="Center">
                    <ToggleButton x:Name="ModeToggle" Height="44" Padding="10,4"
                                  Checked="OnShowMode" Unchecked="OnEditMode"
                                  Background="#c9a227" Foreground="Black"
                                  FontWeight="Bold" Content="Modo: EDIT"/>
                    <Button x:Name="VideoOutButton" Click="OnVideoOutputClick" Height="44"
                            Background="#7e1e1e" Content="🖵 Salida vídeo"/>
                    <Button Click="OnSettingsClick" Height="44" Content="⚙ Configuración"/>
                </StackPanel>

                <!-- Centro: reloj del show (el countdown por cue vive en las
                     tarjetas de EN REPRODUCCIÓN y en el progreso de la fila) -->
                <Border x:Name="ShowClockBox" Background="#151515" CornerRadius="4"
                        Padding="12,2" Cursor="Hand"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        MouseLeftButtonDown="OnShowClockClick"
                        ToolTip="Clic: alternar restante/transcurrido · Doble clic: reiniciar">
                    <StackPanel>
                        <TextBlock x:Name="ShowClockMode" Text="SHOW · RESTANTE ▾"
                                   FontSize="9" Foreground="{StaticResource FgDim}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="ShowClockText" Text="0:00:00"
                                   FontSize="26" FontWeight="Bold"
                                   FontFamily="Consolas" Foreground="#e8c000"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- ═══════════ TOOLBAR: lista ═══════════ -->
        <Border DockPanel.Dock="Top" Background="#2a2a2b" Padding="8,4">
            <StackPanel Orientation="Horizontal">
                <Button Click="OnOpenShow" Content="📂 Abrir"/>
                <Button Click="OnSaveShow" Content="💾 Guardar"/>
                <Separator Width="14" Background="Transparent"/>
                <TextBlock Text="Añadir:" VerticalAlignment="Center" Margin="0,0,4,0"
                           Foreground="{StaticResource FgDim}"/>
                <Button Click="OnAddCue" Tag="AUDIO" Content="♪ Audio"/>
                <Button Click="OnAddCue" Tag="VIDEO" Content="▣ Vídeo"/>
                <Button Click="OnAddCue" Tag="WAIT" Content="⏱ Wait"/>
                <Button Click="OnAddCue" Tag="FADE" Content="◢ Fade"/>
                <Button Click="OnAddCue" Tag="START" Content="▶ Start"/>
                <Button Click="OnAddCue" Tag="STOP" Content="■ Stop"/>
                <Button Click="OnAddCue" Tag="SCRIPT" Content="⚙ Script"/>
                <Button Click="OnAddCue" Tag="MEMO" Content="✎ Memo"/>
                <Button Click="OnAddCue" Tag="GROUP" Content="▸ Grupo"/>
                <Separator Width="14" Background="Transparent"/>
                <Button Click="OnImportFiles" Content="＋ Importar archivos…"/>
                <Button x:Name="DeleteButton" Click="OnDeleteCue" Content="🗑 Eliminar"/>
            </StackPanel>
        </Border>

        <!-- ═══════════ STATUS BAR ═══════════ -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" Padding="8,4">
            <DockPanel>
                <TextBlock x:Name="TallyLabel" DockPanel.Dock="Right" Text="SALIDA: NEGRO"
                           Foreground="{StaticResource FgDim}"/>
                <TextBlock x:Name="StatusLabel" Text="Listo."/>
            </DockPanel>
        </Border>

        <!-- ═══════════ PANEL IZQ: monitores + cues activos ═══════════ -->
        <Border DockPanel.Dock="Left" Width="260" Background="{StaticResource Panel}"
                Padding="8">
            <DockPanel>
                <!-- Mini-monitores PVW / PGM (se rellenan desde código) -->
                <StackPanel x:Name="MonitorHost" DockPanel.Dock="Top"
                            Margin="0,0,0,10"/>
                <!-- Notas del cue en standby -->
                <Border x:Name="NotesPanel" DockPanel.Dock="Top" Background="#2d2a1e"
                        CornerRadius="4" Padding="8,6" Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="NOTAS DEL SIGUIENTE" FontSize="9"
                                   Foreground="#a89968"/>
                        <TextBlock x:Name="NotesText" TextWrapping="Wrap"
                                   Foreground="#e8dcb8" FontSize="13"/>
                    </StackPanel>
                </Border>
                <TextBlock DockPanel.Dock="Top" Text="EN REPRODUCCIÓN" FontWeight="Bold"
                           Foreground="{StaticResource FgDim}" Margin="0,0,0,6"/>
                <ItemsControl x:Name="ActiveList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#333" CornerRadius="4" Padding="8,6"
                                    Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="■"
                                            Width="26" Height="26" Margin="6,0,0,0"
                                            Background="#5a2a2a" Foreground="#ddd"
                                            BorderBrush="#703030"
                                            ToolTip="Detener este cue"
                                            Tag="{Binding Id}" Click="OnActiveStopClick"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding TimeText}"
                                                   Foreground="#2ecc71" FontFamily="Consolas"/>
                                        <ProgressBar Height="4" Maximum="1"
                                                     Value="{Binding Fraction, Mode=OneWay}"
                                                     Foreground="#2ecc71" Background="#222"
                                                     Margin="0,4,0,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- ═══════════ CENTRO: tabla + (inspector | timeline) ═══════════ -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="330" MinHeight="140"/>
            </Grid.RowDefinitions>

        <DataGrid x:Name="CueGrid" Grid.Row="0"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="{StaticResource Bg}" Foreground="{StaticResource Fg}"
                  RowHeight="30" FontSize="13"
                  BorderThickness="0" SelectionMode="Extended" SelectionUnit="FullRow"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  SelectionChanged="OnGridSelectionChanged"
                  MouseDoubleClick="OnGridDoubleClick"
                  PreviewMouseLeftButtonDown="OnGridMouseDown"
                  PreviewMouseMove="OnGridMouseMove"
                  Drop="OnGridDrop" AllowDrop="True">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#2d2d30"/>
                    <Setter Property="Foreground" Value="#bbb"/>
                    <Setter Property="Padding" Value="6,4"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Visibility" Value="{Binding RowVisibility}"/>
                    <!-- Progreso del cue embebido en la fila (estilo QLab) -->
                    <Setter Property="Background" Value="{Binding RowBrush}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlayhead}" Value="True">
                            <Setter Property="Background" Value="{StaticResource PlayheadBg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="" Width="26">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Ellipse Width="10" Height="10" Fill="{Binding StateBrush}"
                                     VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Nº" Width="52">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Border Background="{Binding LabelBrush}" CornerRadius="3"
                                    Padding="4,1">
                                <TextBlock Text="{Binding Number}" Foreground="#ddd"/>
                            </Border>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Tipo" Width="88">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding TypeLabel}"
                                       Foreground="{Binding TypeBrush}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Nombre" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Margin="{Binding NameIndent}"
                                       Foreground="#ddd" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Pre" Binding="{Binding PreWaitText}" Width="56"/>
                <DataGridTextColumn Header="Dur" Binding="{Binding DurationText}" Width="64"/>
                <DataGridTextColumn Header="Post" Binding="{Binding PostWaitText}" Width="56"/>
                <DataGridTextColumn Header="Sigue" Binding="{Binding ContinueText}" Width="72"/>
                <DataGridTextColumn x:Name="LatColumn" Header="Lat"
                                    Binding="{Binding LatencyText}" Width="60"/>
                <DataGridTextColumn Header="⚑" Binding="{Binding FlagText}" Width="28"/>
                <DataGridTextColumn Header="✕" Binding="{Binding ArmedText}" Width="28"/>
            </DataGrid.Columns>
        </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="#333333" ResizeBehavior="PreviousAndNext"/>

            <!-- Zona inferior: inspector y timeline comparten sitio.
                 En modo SHOW se selecciona sola la pestaña del timeline. -->
            <TabControl x:Name="BottomTabs" Grid.Row="2"
                        Background="#252526" BorderThickness="0" Padding="0">
                <TabItem Header="🛠 Inspector">
                    <local:InspectorPanel x:Name="Inspector" Background="#252526"/>
                </TabItem>
                <TabItem Header="⏱ Timeline">
                    <local:TimelinePanel x:Name="Timeline"/>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</Window>
