<Window x:Class="WinCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WinCue.App"
        Title="{local:Loc Es=WinCue — Configuración, En=WinCue — Settings}" Width="760" Height="640"
        Background="{DynamicResource SunkenBg}" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Los colores vienen de la paleta central (Theme.cs), publicada en
             Application.Resources desde App.OnStartup → {DynamicResource}. -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
            <!-- Hover con borde ámbar (sin el azul-claro feo de WPF) -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrightAlt}"/>
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <!-- Plantilla propia: la de WPF no respetaba el color del texto de
                 la opción SELECCIONADA en la caja cerrada (salía casi negro).
                 Aquí la caja es oscura y el texto claro, garantizado. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tgl" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource ControlBg}" BorderBrush="{DynamicResource Border}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Fill="{DynamicResource TextTertiary}"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,0,24,0" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextBrightAlt}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="{DynamicResource ListBg}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Opciones del desplegable UNIFORMES: plantilla propia porque la de
             WPF tiene un estado 'ratón encima' que pinta blanco y mataba el
             texto claro. Item oscuro + texto claro + resaltado azul. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrightAlt}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBg" Background="{DynamicResource ListBg}"
                                Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBg" Property="Background" Value="{DynamicResource SelectionBg}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBg" Property="Background" Value="{DynamicResource Teal}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Botonera inferior -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="{local:Loc Es=Restaurar valores de fábrica, En=Restore factory defaults}"
                    Click="OnResetDefaults"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{local:Loc Es=Cancelar, En=Cancel}" Width="90" Click="OnCancel"/>
                <Button Content="{local:Loc Es=Guardar, En=Save}" Width="90" Background="{DynamicResource GoButton}"
                        FontWeight="Bold" Click="OnSave"/>
            </StackPanel>
        </DockPanel>

        <!-- Las pestañas se rellenan desde código (BuildPages) -->
        <TabControl x:Name="Tabs" Background="{DynamicResource WindowBg}" BorderBrush="{DynamicResource Divider}"/>
    </DockPanel>
</Window>
