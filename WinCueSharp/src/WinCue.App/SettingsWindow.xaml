<Window x:Class="WinCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCue — Configuración" Width="760" Height="640"
        Background="#1a1a1a" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#dddddd"/>
        <SolidColorBrush x:Key="FgDim" Color="#999999"/>
        <SolidColorBrush x:Key="Accent" Color="#e8a200"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#2a2a2a"/>
        </Style>
        <!-- Opciones del desplegable LEGIBLES: texto claro sobre item oscuro,
             resaltado azul (antes: gris tenue sobre oscuro, ilegible) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Background" Value="#262626"/>
            <Setter Property="Padding" Value="7,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="#37527a"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#37527a"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Botonera inferior -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Restaurar valores de fábrica"
                    Click="OnResetDefaults"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="90" Click="OnCancel"/>
                <Button Content="Guardar" Width="90" Background="#1e7e34"
                        FontWeight="Bold" Click="OnSave"/>
            </StackPanel>
        </DockPanel>

        <!-- Las pestañas se rellenan desde código (BuildPages) -->
        <TabControl x:Name="Tabs" Background="#1e1e1e" BorderBrush="#333"/>
    </DockPanel>
</Window>
