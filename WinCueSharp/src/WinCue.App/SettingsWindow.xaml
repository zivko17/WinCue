<Window x:Class="WinCue.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinCue — Configuración" Width="760" Height="640"
        Background="#1a1a1a" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#dddddd"/>
        <SolidColorBrush x:Key="FgDim" Color="#999999"/>
        <SolidColorBrush x:Key="Accent" Color="#e8a200"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3c3c3c"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#555"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="MinWidth" Value="220"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="Background" Value="#2a2a2a"/>
            <!-- Plantilla propia: la de WPF no respetaba el color del texto de
                 la opción SELECCIONADA en la caja cerrada (salía casi negro).
                 Aquí la caja es oscura y el texto claro, garantizado. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="tgl" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2a2a2a" BorderBrush="#555"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,8,0" Fill="#bbbbbb"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="9,0,24,0" VerticalAlignment="Center"
                                              TextElement.Foreground="#e6e6e6"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#262626" BorderBrush="#555" BorderThickness="1">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Opciones del desplegable UNIFORMES: plantilla propia porque la de
             WPF tiene un estado 'ratón encima' que pinta blanco y mataba el
             texto claro. Item oscuro + texto claro + resaltado azul. -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#e6e6e6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="itemBg" Background="#262626"
                                Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="itemBg" Property="Background" Value="#37527a"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="itemBg" Property="Background" Value="#2f6f4f"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2a2a2a"/>
            <Setter Property="Foreground" Value="{StaticResource Fg}"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource FgDim}"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="Margin" Value="0,4,0,10"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="10">
        <!-- Botonera inferior -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Content="Restaurar valores de fábrica"
                    Click="OnResetDefaults"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Width="90" Click="OnCancel"/>
                <Button Content="Guardar" Width="90" Background="#1e7e34"
                        FontWeight="Bold" Click="OnSave"/>
            </StackPanel>
        </DockPanel>

        <!-- Las pestañas se rellenan desde código (BuildPages) -->
        <TabControl x:Name="Tabs" Background="#1e1e1e" BorderBrush="#333"/>
    </DockPanel>
</Window>
