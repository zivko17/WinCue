<Application x:Class="WinCue.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinCue.App"
             xmlns:icons="clr-namespace:WinCue.Presentation;assembly=WinCue.Presentation">
    <!-- Sin StartupUri: la ventana se construye en App.OnStartup (composición) -->
    <Application.Resources>

        <!-- ══════════ Fuente de iconos en los POPUPS ══════════
             La fuente se fija en la raíz de cada ventana y se hereda por el
             árbol… pero un menú, un tooltip o el desplegable de un ComboBox
             NO cuelgan de ese árbol: viven en un Popup, con su propia ventana.
             Ahí la herencia no llega y los glifos salían como cuadritos.
             Estos estilos implícitos sí los alcanzan, porque Application.
             Resources es el último eslabón de búsqueda para TODO el proceso. -->

        <!-- ══════════ Menús y tooltips ══════════
             Iban con la plantilla de serie de WPF, que es CLARA: sobre un tema
             oscuro el menú salía blanco. Aquí se retempla entero.

             La plantilla del ítem rehace a mano tres cosas que la de WPF traía
             gratis y que al retemplar se pierden EN SILENCIO si no las pones: el
             SUBMENÚ (Popup + StackPanel de ítems), la MARCA de los marcables y
             el texto del atajo. En estos menús hay de las tres. -->

        <!-- Panel flotante: mismo canto que una tecla, porque también está por
             encima de la superficie. -->
        <ControlTemplate x:Key="MenuPanel" TargetType="ContextMenu">
            <Border Background="{DynamicResource ListBg}"
                    BorderBrush="{DynamicResource BevelEdge}"
                    BorderThickness="1" CornerRadius="4" Padding="4"
                    SnapsToDevicePixels="True">
                <StackPanel IsItemsHost="True"
                            KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
        </ControlTemplate>

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{x:Static local:IconFont.Font}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <!-- La sombra de serie dibuja un halo claro que delata el chrome de
                 Windows; el canto ya separa el menú del fondo. -->
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Template" Value="{StaticResource MenuPanel}"/>
        </Style>

        <!-- Ítem HOJA. La primera columna es la de la marca y se reserva SIEMPRE,
             para que el texto quede alineado tengan marca o no. El glifo del tipo
             de cue NO va ahí: viaja dentro del Header, que es como lo arma
             {local:Loc Icon=…}. -->
        <ControlTemplate x:Key="MenuLeaf" TargetType="MenuItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="check" Grid.Column="0"
                               Text="{x:Static icons:Icons.Check}"
                               Visibility="Collapsed"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource Standby}"/>
                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    <TextBlock Grid.Column="2"
                               Text="{TemplateBinding InputGestureText}"
                               VerticalAlignment="Center" Margin="18,0,10,0"
                               Foreground="{DynamicResource TextMuted}"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Ítem con SUBMENÚ. Sin este Popup el submenú NO se abre: lo monta la
             plantilla, no el control. -->
        <ControlTemplate x:Key="MenuBranch" TargetType="MenuItem">
            <Border x:Name="bd" Background="Transparent" CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Grid.Column="1" ContentSource="Header"
                                      RecognizesAccessKey="True"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                    <Path Grid.Column="2" Data="M 0 0 L 4 4 L 0 8 Z"
                          Fill="{DynamicResource TextMuted}"
                          VerticalAlignment="Center" Margin="18,0,8,0"/>
                    <Popup IsOpen="{TemplateBinding IsSubmenuOpen}"
                           Placement="Right" HorizontalOffset="-3"
                           AllowsTransparency="True" Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource ListBg}"
                                BorderBrush="{DynamicResource BevelEdge}"
                                BorderThickness="1" CornerRadius="4" Padding="4"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectionBg}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{x:Static local:IconFont.Font}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Padding" Value="6,6"/>
            <Setter Property="Template" Value="{StaticResource MenuLeaf}"/>
            <Style.Triggers>
                <!-- Role lo fija WPF: SubmenuHeader = este ítem TIENE hijos. -->
                <Trigger Property="Role" Value="SubmenuHeader">
                    <Setter Property="Template" Value="{StaticResource MenuBranch}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Separador SOLO dentro de menús. Va con la clave que WPF reserva para
             eso y NO como estilo implícito de Separator: en la barra de
             herramientas hay Separator usados como hueco en blanco, y un estilo
             implícito les pintaría una raya. -->
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Background" Value="{DynamicResource Divider}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Background="{TemplateBinding Background}" Height="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{x:Static local:IconFont.Font}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{DynamicResource ControlBg}"
                                BorderBrush="{DynamicResource BevelEdge}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="8,5" SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ Tema oscuro global ══════════
             Los COLORES no viven aquí: están en Theme.cs, que los publica en
             este mismo diccionario desde App.OnStartup. Por eso se referencian
             con {DynamicResource} (StaticResource se resolvería al parsear este
             fichero, antes de que la paleta exista). -->

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Warn}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <!-- ══════════ Seleccionables ══════════
             CheckBox y RadioButton iban con la plantilla de serie de WPF, que
             es la del sistema: casilla clara con marca azul. Aquí siguen la
             misma gramática que el resto — casilla HUNDIDA (contiene un valor,
             no se pulsa) y la marca en ámbar, que es el color que ya significa
             «esto está puesto» en toda la consola. -->

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{x:Static local:IconFont.Font}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="box" Width="15" Height="15" CornerRadius="3"
                                    Background="{DynamicResource ControlBg}"
                                    BorderBrush="{DynamicResource BevelEdge}"
                                    BorderThickness="1" VerticalAlignment="Center"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Border CornerRadius="2"
                                            Background="{DynamicResource BevelFacePressed}"/>
                                    <TextBlock x:Name="mark"
                                               Text="{x:Static icons:Icons.Check}"
                                               FontSize="10" Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Standby}"/>
                                </Grid>
                            </Border>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- Indeterminado: existe en WPF y sin esto se vería
                                 igual que «sin marcar», que es una mentira. -->
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter TargetName="mark" Property="Text" Value="–"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="15" Height="15" VerticalAlignment="Center">
                                <Ellipse x:Name="ring"
                                         Fill="{DynamicResource ControlBg}"
                                         Stroke="{DynamicResource BevelEdge}"
                                         StrokeThickness="1"/>
                                <Ellipse Fill="{DynamicResource BevelFacePressed}" Margin="1"/>
                                <Ellipse x:Name="dot" Margin="4" Visibility="Collapsed"
                                         Fill="{DynamicResource Standby}"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource Standby}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════════ Faders ══════════
             La ranura va HUNDIDA y el pomo en RELIEVE: es exactamente lo que es
             un fader de mesa, y encaja con la regla de la casa (hundido =
             contiene, relieve = lo tocas).

             Hay DOS plantillas porque en la app hay faders verticales de verdad
             (VOL del mixer, ganancia del EQ, niveles del inspector) y una sola
             plantilla horizontal los dejaría con la ranura cruzada. -->

        <ControlTemplate x:Key="FaderThumb" TargetType="Thumb">
            <Border Background="{DynamicResource ButtonBg}"
                    BorderBrush="{DynamicResource BevelEdge}"
                    BorderThickness="1" CornerRadius="3"
                    SnapsToDevicePixels="True">
                <Border CornerRadius="2" Background="{DynamicResource BevelFace}"/>
            </Border>
        </ControlTemplate>

        <!-- Los RepeatButton del Track (saltar de página al clicar la ranura)
             tienen que seguir EXISTIENDO para que ese clic funcione, pero sin
             dibujar nada: con su plantilla de serie pintarían dos botones sobre
             la ranura. -->
        <ControlTemplate x:Key="FaderTrackPiece" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>

        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="6" VerticalAlignment="Center" CornerRadius="3"
                                    Background="{DynamicResource SunkenBg}"
                                    BorderBrush="{DynamicResource BevelEdge}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <Border CornerRadius="2"
                                        Background="{DynamicResource BevelFacePressed}"/>
                            </Border>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                  Template="{StaticResource FaderTrackPiece}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                  Template="{StaticResource FaderTrackPiece}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="13" Height="20"
                                           Template="{StaticResource FaderThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Slider">
                                <Grid>
                                    <Border Width="6" HorizontalAlignment="Center" CornerRadius="3"
                                            Background="{DynamicResource SunkenBg}"
                                            BorderBrush="{DynamicResource BevelEdge}"
                                            BorderThickness="1" SnapsToDevicePixels="True">
                                        <Border CornerRadius="2"
                                                Background="{DynamicResource BevelFacePressed}"/>
                                    </Border>
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                                          Template="{StaticResource FaderTrackPiece}"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                                          Template="{StaticResource FaderTrackPiece}"/>
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="20" Height="13"
                                                   Template="{StaticResource FaderThumb}"/>
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ══════════ Interruptor enclavable ══════════
             Mismo relieve de tecla que Button, más un estado que Button no
             tiene: ENCLAVADO. Un toggle activo se queda hundido, como el botón
             de una mesa que se queda dentro — que es exactamente lo que
             significa (los 0°/90°/180°/270° del inspector son un grupo de
             enclavamiento). Antes la selección era el azul por defecto de WPF,
             que en un tema oscuro casi no se veía.
             No afecta a los toggles que traen Template propia (la caja del
             ComboBox, el interruptor de modo): una plantilla puesta a mano gana
             siempre al setter de un estilo. -->
        <Style TargetType="{x:Type ToggleButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BevelEdge}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="face" CornerRadius="3"
                                        Background="{DynamicResource BevelFace}"/>
                                <Border x:Name="veil" CornerRadius="3"
                                        Background="Transparent"/>
                                <ContentPresenter x:Name="cp"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="veil" Property="Background" Value="{DynamicResource BevelHover}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                            </Trigger>
                            <!-- Enclavado: se queda hundido y con el filo ámbar,
                                 para que se lea de un vistazo cuál del grupo
                                 está puesto. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="face" Property="Background" Value="{DynamicResource BevelFacePressed}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                                <Setter TargetName="cp" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="{DynamicResource Standby}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="face" Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox oscuro (retemplado: el estilo de sistema es claro) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <!-- También en Popup: ver la nota de arriba -->
            <Setter Property="FontFamily" Value="{x:Static local:IconFont.Font}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource PlayheadRow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd" Background="{DynamicResource ControlBg}"
                                                BorderBrush="{DynamicResource BevelEdge}"
                                                BorderThickness="1" CornerRadius="4"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <Border x:Name="face" CornerRadius="3"
                                                        Background="{DynamicResource BevelFace}"/>
                                                <Border x:Name="veil" CornerRadius="3"
                                                        Background="Transparent"/>
                                                <Path HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,8,0"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="{DynamicResource TextMuted}"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="veil" Property="Background" Value="{DynamicResource BevelHover}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                                            </Trigger>
                                            <!-- Desplegado = hundido: mientras la
                                                 lista está abierta la caja se queda
                                                 dentro, como una tecla sostenida. -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="face" Property="Background" Value="{DynamicResource BevelFacePressed}"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Standby}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,3,24,3"
                                VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ControlBg}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="340">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestañas oscuras (inspector y settings) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <!-- La pestaña INACTIVA sobresale (relieve de tecla) y la
                         ACTIVA se queda plana y del color del panel: deja de ser
                         un botón y pasa a ser el borde de la superficie que
                         estás mirando. Por eso la activa se queda SIN velo, no
                         con el velo invertido — hundirla la separaría del panel,
                         que es lo contrario de lo que tiene que contar. -->
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{DynamicResource DeeperBg}"
                                BorderBrush="{DynamicResource BevelEdge}"
                                BorderThickness="1,1,1,0"
                                CornerRadius="4,4,0,0" Margin="0,0,2,0"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="face" CornerRadius="3,3,0,0"
                                        Background="{DynamicResource BevelFace}"/>
                                <Border x:Name="veil" CornerRadius="3,3,0,0"
                                        Background="Transparent"/>
                                <ContentPresenter ContentSource="Header"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource WindowBg}"/>
                                <Setter TargetName="face" Property="Background"
                                        Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="veil" Property="Background" Value="{DynamicResource BevelHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
