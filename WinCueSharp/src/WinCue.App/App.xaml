<Application x:Class="WinCue.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WinCue.App">
    <!-- Sin StartupUri: la ventana se construye en App.OnStartup (composición) -->
    <Application.Resources>

        <!-- ══════════ Fuente de iconos en los POPUPS ══════════
             La fuente se fija en la raíz de cada ventana y se hereda por el
             árbol… pero un menú, un tooltip o el desplegable de un ComboBox
             NO cuelgan de ese árbol: viven en un Popup, con su propia ventana.
             Ahí la herencia no llega y los glifos salían como cuadritos.
             Estos estilos implícitos sí los alcanzan, porque Application.
             Resources es el último eslabón de búsqueda para TODO el proceso. -->

        <Style TargetType="ContextMenu">
            <Setter Property="FontFamily" Value="{x:Static local:Icons.Font}"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="FontFamily" Value="{x:Static local:Icons.Font}"/>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="FontFamily" Value="{x:Static local:Icons.Font}"/>
        </Style>

        <!-- ══════════ Tema oscuro global ══════════
             Los COLORES no viven aquí: están en Theme.cs, que los publica en
             este mismo diccionario desde App.OnStartup. Por eso se referencian
             con {DynamicResource} (StaticResource se resolvería al parsear este
             fichero, antes de que la paleta exista). -->

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderControl}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Warn}"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- ComboBox oscuro (retemplado: el estilo de sistema es claro) -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <!-- También en Popup: ver la nota de arriba -->
            <Setter Property="FontFamily" Value="{x:Static local:Icons.Font}"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource PlayheadRow}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                    RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{DynamicResource ControlBg}"
                                                BorderBrush="{DynamicResource BorderControl}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,8,0"
                                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                                  Fill="{DynamicResource TextMuted}"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,3,24,3"
                                VerticalAlignment="Center" IsHitTestVisible="False"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Background="{DynamicResource ControlBg}"
                                        BorderBrush="{DynamicResource Border}"
                                        BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="340">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pestañas oscuras (inspector y settings) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bd" Background="{DynamicResource DeeperBg}"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1,1,1,0"
                                Padding="14,5" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{DynamicResource WindowBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Warn}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Application.Resources>
</Application>
