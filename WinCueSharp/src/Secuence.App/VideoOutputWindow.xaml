<Window
    x:Class="Secuence.App.VideoOutputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ==========================================================================
         VideoOutputWindow.xaml — ventana de salida de vídeo (destino de mpv).
         ==========================================================================
         Solo un Grid negro: la ventana hija Win32 que hospeda a mpv (HwndHijo.cs)
         vive FUERA del árbol XAML (es un HWND crudo, no un control) y se pinta
         siempre por encima de este Grid por el airspace de Win32 — ver el aviso
         en HwndHijo.cs. Este fondo negro es lo único que se ve ANTES de que mpv
         tenga wid, y lo que reaparece cuando el blackout oculta el HWND hijo.
         ========================================================================== -->

    <Grid Background="Black">
        <Grid x:Name="FondoNegro" Background="Black"/>

        <!-- Rótulo de IDENTIFICAR: «¿cuál de mis monitores es la salida 2?».
             Vive en el árbol XAML, así que el HWND hijo de mpv lo taparía por
             airspace — por eso ShowIdentify OCULTA el hijo mientras dura, con
             el mismo mecanismo que el blackout. Mientras se identifica no se
             ve el vídeo, igual que en WinCue con sus patrones de prueba. -->
        <Border x:Name="IdentifyOverlay" Visibility="Collapsed"
                BorderThickness="14" Margin="28">
            <TextBlock x:Name="IdentifyText"
                       FontSize="140" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>
