<Project Sdk="Microsoft.NET.Sdk">

  <!-- =========================================================================
       MpvD3D11Lab — PRUEBA DE CONCEPTO del compositor unificado.
       Pregunta que responde: ¿puede mpv (que solo renderiza por OpenGL) dejar
       su frame en una TEXTURA D3D11 del MISMO device que usa el motor HAP,
       para que un único compositor D3D11 muestree ambas fuentes?
       Hoy el interop va GL → D3D9Ex (GlDxInterop.cs) y cada capa acaba en su
       propio D3DImage: la mezcla la hace el DWM. Si este lab sale verde, el
       compositor propio es viable; si sale rojo, hay que replantear la ruta.
       Proyecto paralelo: NO forma parte de la solución WinCueSharp.
       ========================================================================= -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>mpv-d3d11-lab</AssemblyName>
    <RootNamespace>MpvD3D11Lab</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- El lab imprime un veredicto por stdout; sin analizadores estrictos -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <NoWarn>CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mismas versiones que WinCue.Video para que el resultado sea trasladable -->
    <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
  </ItemGroup>

</Project>
